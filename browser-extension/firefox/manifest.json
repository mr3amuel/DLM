{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.1.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "storage"
  ],
  "action": {
    "default_title": "DLM"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "protocol.js",
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browser@dlm.local",
      "strict_min_version": "140.0"
    }
  }
}
